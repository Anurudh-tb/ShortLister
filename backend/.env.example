# LLM mode: "offline" (local Ollama, default) or "online" (hosted OpenAI-compatible API)
LLM_MODE=offline
# Optional override: LLM_PROVIDER=mock runs a deterministic demo provider with no model at all
# LLM_PROVIDER=mock

# --- offline (Ollama) ---
OLLAMA_HOST=http://localhost:11434
MODEL_NAME=qwen2.5:14b
NUM_CTX=8192
LLM_TIMEOUT_S=900
LLM_MAX_RETRIES=2

# --- online (defaults to Groq's free tier; key from https://console.groq.com/keys) ---
# Any OpenAI-compatible API works, e.g. Gemini: https://generativelanguage.googleapis.com/v1beta/openai
ONLINE_BASE_URL=https://api.groq.com/openai/v1
ONLINE_API_KEY=
ONLINE_MODEL_NAME=llama-3.3-70b-versatile
# json_object (works everywhere) or json_schema (server-enforced, only some models)
ONLINE_JSON_MODE=json_object

MAX_FILE_MB=10
OCR_ENABLED=false

# MySQL (start it with `docker compose up -d mysql` from the repo root):
DATABASE_URL=mysql+pymysql://shortlister:shortlister@localhost:3306/shortlister?charset=utf8mb4
# Or a local SQLite file, no server needed:
# DATABASE_URL=sqlite:///./shortlister.db
# Reuse stored rubrics / resume scores when the same JD or resume is run again with the same model
LLM_CACHE_ENABLED=true
# Privacy: keep false to never store extracted resume text in the database
PERSIST_RESUME_TEXT=false

# Sign-in tokens. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Access-token lifetime in minutes. Active users get a fresh token automatically; idle ones sign in again.
JWT_EXPIRE_MINUTES=15

# Rate limits for sign-in / sign-up: requests per IP per minute, and failed logins per username before a lockout
AUTH_RATE_LIMIT_PER_MINUTE=20
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Sign-up: minimum password length (a letter and a number are also required)
PASSWORD_MIN_LENGTH=8

CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]
LOG_LEVEL=INFO
