{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shortlister",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/frontend/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* must reach the Worker code instead of the SPA fallback
    "run_worker_first": ["/api/*"]
  },
  // Private link to the local FastAPI server: named tunnel "shortlister-backend" -> 127.0.0.1:8000.
  // Keep `npx wrangler tunnel run 126061e5-be84-4738-ab74-3af66eb74d63` running on the backend machine.
  "vpc_services": [
    { "binding": "BACKEND", "service_id": "01a1c93d-d414-7bb2-a85e-d22984d06adf" }
  ]
}
